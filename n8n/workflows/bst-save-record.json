    },
    {
      "parameters": {
        "jsCode": "function generateUUID() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {\n    const r = (Math.random() * 16) | 0;\n    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);\n  });\n}\n\nconst body = $input.first().json.body || $input.first().json;\nconst userId = (body.userId || body.userid || '').toString().trim();\nconst mealContext = (body.mealContext || body.meal_context || '').toString().trim();\nconst source = (body.source || 'manual').toString().trim();\nconst notes = (body.notes || '').toString().trim();\n\nlet bloodSugar = Number(body.bloodSugar ?? body.blood_sugar ?? body.BloodSugar);\n\nif (!userId) {\n  return [{ json: { error: true, statusCode: 400, message: 'شناسه کاربر الزامی است' } }];\n}\nif (!mealContext) {\n  return [{ json: { error: true, statusCode: 400, message: 'زمان‌بندی وعده الزامی است' } }];\n}\nif (!bloodSugar || isNaN(bloodSugar) || bloodSugar < 20 || bloodSugar > 600) {\n  return [{ json: { error: true, statusCode: 400, message: 'مقدار قند خون نامعتبر است' } }];\n}\n\nconst now = new Date();\n\nreturn [{\n  json: {\n    error: false,\n    recordId: generateUUID(),\n    userId,\n    Date: now.toLocaleDateString('fa-IR'),\n    Time: now.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' }),\n    BloodSugar: Math.round(bloodSugar),\n    MealContext: mealContext,\n    Source: source,\n    Notes: notes || (source === 'manual' ? 'ثبت دستی' : 'ثبت از آنالیز عکس'),\n    createdAt: now.toISOString()\n  }\n}];"
      },
      "id": "e1b2c3d4-0001-4000-8000-000000000002",
